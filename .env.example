# ============================================================
# YouTube Automatizado - Variables de entorno
# Copia este archivo a `.env` y rellena las claves.
# NUNCA commitees `.env` al repositorio.
# ============================================================

# --- Modelos de lenguaje (ideación, guiones, auditoría) ---
# Claude Sonnet 4.6 / Opus 4.7 (Vision) -> https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_OPUS=claude-opus-4-7

# Google Gemini (Deep Research, Ask Studio, Inspiration Tab vía API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Audio / Locución ---
# ElevenLabs (Multilingual v2, Expressive Speech, Dubbing)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Visuales (Imagen / Video) ---
# Nano Banana (Google) y Seedance 2.0 (TopMedia AI) - rellenar según proveedor
NANOBANANA_API_KEY=
SEEDANCE_API_KEY=
TOPMEDIA_API_KEY=

# --- YouTube Data API v3 (publicación, MLA, analytics) ---
# OAuth2: descarga client_secret.json desde Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_CHANNEL_ID=

# --- Configuración del canal/proyecto ---
PROJECT_NAME=canal_demo
DEFAULT_LANGUAGE=es
# Mercado primario US-Hispanic (RPM x4) - secundarios EN para doblaje
TARGET_MARKETS=US-Hispanic,EN-US
DEFAULT_NICHE=
# Formato editorial: long_form (10-20 min) | masterclass (1-6h) | shorts | mixed
CONTENT_FORMAT=long_form
TARGET_DURATION_MIN=12
